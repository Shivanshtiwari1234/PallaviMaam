SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Optional: override default compose database URL
# DATABASE_URL=postgres://learneng:learneng@db:5432/learneng

# Optional tuning
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
DJANGO_LOG_LEVEL=INFO

# Postgres container defaults used by docker-compose
POSTGRES_DB=learneng
POSTGRES_USER=learneng
POSTGRES_PASSWORD=learneng
